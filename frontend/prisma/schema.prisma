generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
  ALUMNI
  SUSPENDED
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum RowStatus {
  SUCCESS
  FAILED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ImportField {
  REGISTRATION_NUMBER
  STUDENT_NAME
  FATHER_NAME
  MOTHER_NAME
  PHONE
  EMAIL
  ADDRESS
  CITY
  STATE
  PIN_CODE
  AADHAAR_NUMBER
  GENDER
  DATE_OF_BIRTH
  COURSE
  ADMISSION_DATE
  MR_NUMBER
  RECEIPT_DATE
  AMOUNT_PAID
  UNKNOWN
}

enum InstallmentType {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  CUSTOM
}

enum PaymentStatus {
  PAID
  PENDING
  PARTIAL
  FAILED
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CHEQUE
  ONLINE
}

enum FeeType {
  ADMISSION
  MONTHLY
  CERTIFICATE
  OTHER
}

enum DocumentType {
  PHOTO

  ADMISSION_FORM

  AADHAAR
  PAN
  PASSPORT
  VOTER_ID

  MARKSHEET_10
  MARKSHEET_12
  DIPLOMA
  DEGREE
  TRANSFER_CERTIFICATE
  MIGRATION_CERTIFICATE

  BONAFIDE
  CHARACTER_CERTIFICATE

  RECEIPT
  INVOICE

  ID_CARD

  CERTIFICATE

  SIGNATURE

  AGREEMENT
  MEDICAL
  OTHER
}

model School {
  id String @id @default(uuid())

  name String
  code String @unique

  users    User[]
  students Student[]

  teachers     Teacher[]
  courses      Course[]
  batches      Batch[]
  admissions   Admission[]
  feeSchedules FeeSchedule[]

  documents          Document[]
  importHeaderMemory ImportHeaderMemory[]

  importJobs ImportJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id String @id @default(uuid())

  schoolId String

  name         String
  email        String @unique
  passwordHash String

  role     UserRole @default(ADMIN)
  isActive Boolean  @default(true)

  school School @relation(fields: [schoolId], references: [id])

  importJobs  ImportJob[]
  resetTokens PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

model Student {
  id String @id @default(uuid())

  schoolId String

  registrationNumber String
  name               String

  fatherName String?
  motherName String?

  gender      Gender?
  dateOfBirth DateTime?

  bloodGroup String?

  studentPhone String?
  parentPhone  String?

  email String?

  address String?
  city    String?
  state   String?
  pinCode String?

  aadhaarNumber String?
  photoUrl      String?

  status StudentStatus @default(ACTIVE)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  admissions Admission[]

  importRows ImportRow[]
  documents  Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, registrationNumber])
  @@index([schoolId])
  @@index([status])
}

model ImportJob {
  id String @id @default(uuid())

  schoolId     String
  importedById String

  fileName String

  status ImportStatus @default(PENDING)

  totalRows   Int @default(0)
  successRows Int @default(0)
  failedRows  Int @default(0)

  completedAt DateTime?

  school School @relation(fields: [schoolId], references: [id])

  importedBy User @relation(fields: [importedById], references: [id])

  rows ImportRow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([importedById])
}

model ImportRow {
  id String @id @default(uuid())

  importJobId String
  studentId   String?

  rowNumber Int

  status RowStatus

  errorMessage String?

  rawData Json

  importJob ImportJob @relation(fields: [importJobId], references: [id])

  student Student? @relation(fields: [studentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([importJobId])
  @@index([studentId])
}

model PasswordResetToken {
  id String @id @default(cuid())

  userId String

  otpHash String

  expiresAt DateTime

  used Boolean @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * ============================================================================
 * COURSE
 * ============================================================================
 */

model Course {
  id String @id @default(uuid())

  schoolId String

  code String
  name String

  durationMonths Int @default(1)

  admissionFee   Decimal @default(0) @db.Decimal(10, 2)
  monthlyFee     Decimal @default(0) @db.Decimal(10, 2)
  certificateFee Decimal @default(0) @db.Decimal(10, 2)
  totalFee       Decimal @default(0) @db.Decimal(10, 2)

  installmentCount Int @default(1)

  isActive Boolean @default(true)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  batches Batch[]

  admissions Admission[]

  feeSchedules FeeSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, code])
  @@index([schoolId])
}

/**
 * ============================================================================
 * TEACHER
 * ============================================================================
 */

enum TeacherStatus {
  ACTIVE
  INACTIVE
}

enum TeacherType {
  FULL_TIME
  PART_TIME
  GUEST
}

model Teacher {
  id String @id @default(uuid())

  schoolId String

  name  String
  email String?
  phone String?

  employeeCode String?

  status TeacherStatus @default(ACTIVE)
  type   TeacherType   @default(FULL_TIME)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  batches Batch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, employeeCode])
  @@index([schoolId])
  @@index([status])
}

/**
 * ============================================================================
 * BATCH
 * ============================================================================
 */

enum BatchStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum BatchShift {
  MORNING
  AFTERNOON
  EVENING
}

model Batch {
  id String @id @default(uuid())

  schoolId String
  courseId String

  teacherId String?

  name String
  code String?

  status BatchStatus @default(ACTIVE)
  shift  BatchShift  @default(MORNING)

  capacity Int @default(30)

  startTime String?
  endTime   String?

  startDate DateTime?
  endDate   DateTime?

  isActive Boolean @default(true)
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  admissions Admission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([courseId])
  @@index([teacherId])
}

/**
 * ============================================================================
 * ADMISSION
 * ============================================================================
 */

model Admission {
  id String @id @default(uuid())

  schoolId String

  studentId String
  courseId  String
  batchId   String?

  barcode String @unique

  admissionDate DateTime

  session String?

  batchName   String?
  trainerName String?

  admissionFee Decimal @db.Decimal(10, 2)

  monthlyFee     Decimal @default(0) @db.Decimal(10, 2)
  certificateFee Decimal @default(0) @db.Decimal(10, 2)
  totalFee       Decimal @default(0) @db.Decimal(10, 2)

  discount Decimal @default(0) @db.Decimal(10, 2)

  expectedCompletionDate DateTime?

  isActive Boolean @default(true)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  batch Batch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  feePayments FeePayment[]
  feeLedger   FeeLedger[]
  documents   Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, courseId, batchId])
  @@index([schoolId])
  @@index([studentId])
  @@index([courseId])
  @@index([batchId])
  @@index([session])
  @@index([isActive])
}

model FeeSchedule {
  id String @id @default(uuid())

  schoolId String
  courseId String

  title String

  amount Decimal @db.Decimal(10, 2)

  dueOrder Int

  isMandatory Boolean @default(true)
  isActive    Boolean @default(true)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  course        Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  ledgerEntries FeeLedger[]

  paymentItems PaymentItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, title])
  @@index([schoolId])
  @@index([courseId])
}

model FeeLedger {
  id String @id @default(uuid())

  admissionId   String
  feeScheduleId String?

  title   String
  feeType FeeType

  amount     Decimal @db.Decimal(10, 2)
  paidAmount Decimal @default(0) @db.Decimal(10, 2)
  dueAmount  Decimal @default(0) @db.Decimal(10, 2)

  dueDate DateTime?

  installmentNumber Int?
  installmentType   InstallmentType?

  status PaymentStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admission Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  feeSchedule FeeSchedule? @relation(fields: [feeScheduleId], references: [id], onDelete: SetNull)

  @@index([admissionId])
  @@index([feeScheduleId])
  @@index([feeType])
}

model FeePayment {
  id String @id @default(uuid())

  admissionId String

  mrNumber      String?
  receiptNumber String?   @unique
  receiptDate   DateTime?

  amountPaid Decimal @db.Decimal(10, 2)

  status PaymentStatus @default(PAID)

  paymentMethod PaymentMethod @default(CASH)

  transactionId String?

  remarks String?

  collectedBy String?

  admission Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  paymentItems PaymentItem[]

  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([admissionId])
  @@index([status])
  @@index([receiptDate])
  @@index([paymentMethod])
}

model PaymentItem {
  id String @id @default(uuid())

  paymentId String

  feeScheduleId String

  title String

  amount Decimal @db.Decimal(10, 2)

  payment FeePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  feeSchedule FeeSchedule @relation(fields: [feeScheduleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([feeScheduleId])
}

model Document {
  id String @id @default(cuid())

  schoolId String

  studentId    String?
  admissionId  String?
  feePaymentId String?

  type DocumentType

  title String

  originalName String
  storedName   String

  relativePath String

  mimeType  String
  extension String

  size Int

  uploadedBy String?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  admission Admission? @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  feePayment FeePayment? @relation(fields: [feePaymentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([studentId])
  @@index([admissionId])
  @@index([feePaymentId])
  @@index([type])
}

model ImportHeaderMemory {
  id String @id @default(cuid())

  schoolId String

  originalHeader   String
  normalizedHeader String

  mappedField ImportField

  confidence Int @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, normalizedHeader])
  @@index([schoolId])
}
